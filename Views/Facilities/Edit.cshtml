@model MediBook.Models.Facility

@{
    ViewData["Title"] = "Edit Facility";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="page-header-icon">
            <i class="fas fa-pen-to-square"></i>
        </div>
        <h1>Edit Facility</h1>
        <p>Update the details for this clinical facility</p>
    </div>
</div>

<!-- Form Content -->
<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Facilities</a>
                    </li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>

            <div class="medibook-form-card">

                <!-- Card Header -->
                <div class="detail-card-header"
                     style="border-radius:12px 12px 0 0;
                            margin:-2.5rem -2.5rem 2rem -2.5rem;
                            padding:1.5rem 2rem;">
                    <i class="fas fa-pen"></i>
                    <h4>Edit — @Model.Name</h4>
                </div>

                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger d-flex align-items-center gap-2 mb-4"
                         style="border-radius:10px; font-size:0.88rem;">
                        <i class="fas fa-circle-exclamation"></i>
                        <div></div>
                    </div>

                    <input type="hidden" asp-for="FacilityId" />

                    <!-- Facility Name -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag"></i> Facility Name
                        </label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Location -->
                    <div class="mb-4">
                        <label asp-for="Location" class="form-label">
                            <i class="fas fa-location-dot"></i> Location
                        </label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="fas fa-align-left"></i> Description
                            <span style="font-weight:400; color:#94a3b8; font-size:0.8rem;">(optional)</span>
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <div class="form-text">Maximum 300 characters.</div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Capacity -->
                    <div class="mb-4">
                        <label asp-for="Capacity" class="form-label">
                            <i class="fas fa-users"></i> Capacity
                        </label>
                        <input asp-for="Capacity" class="form-control" type="number" min="1" />
                        <div class="form-text">
                            Maximum number of people this facility can accommodate.
                        </div>
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-4">
                        <label asp-for="ImageUrl" class="form-label">
                            <i class="fas fa-image"></i> Image URL
                            <span style="font-weight:400; color:#94a3b8; font-size:0.8rem;">(optional)</span>
                        </label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <div class="form-text">Leave blank to use the default placeholder image.</div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <!-- Current Image Preview -->
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-4 p-3"
                             style="background:#f8faff; border-radius:10px; border:1px solid #e2e8f0;">
                            <p class="form-label mb-2">
                                <i class="fas fa-eye" style="color:#4988C4;"></i> Current Image Preview
                            </p>
                            <img src="@Model.ImageUrl"
                                 alt="Current Facility Image"
                                 style="height:120px; width:auto; border-radius:8px;
                                            border:2px solid #BDE8F5;"
                                 onerror="this.src='/images/placeholder-facility.jpg'" />
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 pt-2 flex-wrap">
                        <button type="submit" class="btn-medibook-primary">
                            <i class="fas fa-floppy-disk"></i> Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.FacilityId"
                           class="btn-medibook-outline">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}