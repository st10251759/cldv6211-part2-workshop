@model MediBook.Models.Facility

@{
    ViewData["Title"] = "Edit Facility";
    bool hasServerErrors = !ViewData.ModelState.IsValid &&
        ViewData.ModelState.Any(k => k.Key != "ImageFile" &&
            k.Value!.Errors.Count > 0);
}

<!-- ── Toast Notification ── -->
<div id="validationToast"
     style="position:fixed; top:24px; right:24px; z-index:9999;
            min-width:320px; max-width:420px; display:none;">
    <div style="background:#fff; border-radius:14px;
                box-shadow:0 8px 32px rgba(15,40,84,0.18);
                border-left:5px solid #dc2626; padding:1rem 1.25rem;
                display:flex; align-items:flex-start; gap:12px;
                animation: slideDown 0.4s ease;">
        <div style="width:36px; height:36px; background:#fee2e2; border-radius:50%;
                    display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <i class="fas fa-circle-exclamation" style="color:#dc2626;"></i>
        </div>
        <div style="flex:1;">
            <div style="font-weight:700; color:#991b1b;
                        font-size:0.92rem; margin-bottom:3px;">
                Required Fields Missing
            </div>
            <div id="toastMessage"
                 style="font-size:0.84rem; color:#7f1d1d; line-height:1.5;">
            </div>
        </div>
        <button onclick="document.getElementById('validationToast').style.display='none'"
                style="background:none; border:none; cursor:pointer;
                       color:#94a3b8; font-size:1rem; padding:0; line-height:1;
                       flex-shrink:0; margin-top:2px;">
            <i class="fas fa-xmark"></i>
        </button>
    </div>
</div>

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="page-header-icon">
            <i class="fas fa-pen-to-square"></i>
        </div>
        <h1>Edit Facility</h1>
        <p>Update the details for this clinical facility</p>
    </div>
</div>

<!-- Form Content -->
<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Facilities</a>
                    </li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>

            <!-- Server-side error summary (blob/image upload errors) -->
            @if (hasServerErrors)
            {
                <div class="d-flex align-items-start gap-3 mb-4 p-3"
                     style="background:#fef2f2; border-radius:12px;
                                border-left:4px solid #dc2626;">
                    <i class="fas fa-circle-exclamation fa-lg mt-1"
                       style="color:#dc2626; flex-shrink:0;"></i>
                    <div asp-validation-summary="ModelOnly"
                         style="font-size:0.88rem; color:#991b1b;"></div>
                </div>
            }

            <div class="medibook-form-card">

                <!-- Card Header -->
                <div class="detail-card-header"
                     style="border-radius:12px 12px 0 0;
                            margin:-2.5rem -2.5rem 2rem -2.5rem;
                            padding:1.5rem 2rem;">
                    <i class="fas fa-pen"></i>
                    <h4>Edit — @Model.Name</h4>
                </div>

                <form asp-action="Edit" enctype="multipart/form-data" id="facilityEditForm"
                      novalidate>

                    <input type="hidden" asp-for="FacilityId" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <!-- Facility Name -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag"></i> Facility Name
                        </label>
                        <input asp-for="Name"
                               id="field-Name"
                               class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Location -->
                    <div class="mb-4">
                        <label asp-for="Location" class="form-label">
                            <i class="fas fa-location-dot"></i> Location
                        </label>
                        <input asp-for="Location"
                               id="field-Location"
                               class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="fas fa-align-left"></i> Description
                            <span style="font-weight:400; color:#94a3b8;
                                         font-size:0.8rem;">(optional)</span>
                        </label>
                        <textarea asp-for="Description"
                                  id="field-Description"
                                  class="form-control"
                                  rows="4"></textarea>
                        <div class="form-text">Maximum 300 characters.</div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Capacity -->
                    <div class="mb-4">
                        <label asp-for="Capacity" class="form-label">
                            <i class="fas fa-users"></i> Capacity
                        </label>
                        <input asp-for="Capacity"
                               id="field-Capacity"
                               class="form-control"
                               type="number"
                               min="1" />
                        <div class="form-text">
                            Maximum number of people this facility can accommodate.
                        </div>
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>

                    <!-- Current Image & Replace Upload -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="fas fa-image"></i> Facility Image
                        </label>

                        <div class="mb-3 p-3"
                             style="background:#f8faff; border-radius:10px;
                                    border:1px solid #e2e8f0;">
                            <p class="form-label mb-2" style="font-size:0.82rem;">
                                <i class="fas fa-eye" style="color:#4988C4;"></i> Current Image
                            </p>
                            <img id="currentImage"
                                 src="@Model.ImageUrl"
                                 alt="Current Facility Image"
                                 style="height:120px; width:auto; border-radius:8px;
                                        border:2px solid #BDE8F5;"
                                 onerror="this.src='/images/placeholder-facility.jpg'" />
                        </div>

                        <p class="form-label mb-2" style="font-size:0.82rem; color:#64748b;">
                            <i class="fas fa-rotate me-1" style="color:#4988C4;"></i>
                            Replace Image
                            <span style="font-weight:400; color:#94a3b8;">
                                (optional — leave blank to keep current)
                            </span>
                        </p>

                        <div style="border:2px dashed #BDE8F5; border-radius:12px;
                                    padding:1.2rem; text-align:center; background:#f8faff;
                                    transition: border-color 0.3s ease;"
                             id="dropZoneEdit"
                             ondragover="event.preventDefault(); this.style.borderColor='#4988C4';"
                             ondragleave="this.style.borderColor='#BDE8F5';"
                             ondrop="handleDrop(event,'ImageFileInput','previewEdit','dropZoneEdit')">
                            <i class="fas fa-cloud-arrow-up fa-xl mb-1"
                               style="color:#4988C4;"></i>
                            <p class="mb-0 mt-1" style="font-size:0.85rem; color:#64748b;">
                                Drag &amp; drop a new image, or
                                <label for="ImageFileInput"
                                       style="color:#1C4D8D; font-weight:600;
                                              cursor:pointer; text-decoration:underline;">
                                    browse
                                </label>
                            </p>
                            <p class="mb-0 mt-1" style="font-size:0.75rem; color:#94a3b8;">
                                JPG, PNG, GIF, WEBP &mdash; max 5 MB
                            </p>
                            <input asp-for="ImageFile"
                                   type="file"
                                   id="ImageFileInput"
                                   accept="image/*"
                                   class="d-none"
                                   onchange="previewImage(this,'previewEdit')" />
                        </div>

                        <div id="previewEdit" class="mt-3 d-none">
                            <p class="form-label mb-2" style="font-size:0.82rem;">
                                <i class="fas fa-eye" style="color:#4988C4;"></i>
                                New Image Preview
                            </p>
                            <img id="previewEditImg" src="#" alt="New Preview"
                                 style="height:120px; width:auto; border-radius:10px;
                                        border:2px solid #4988C4;" />
                            <button type="button"
                                    class="btn-action btn-action-delete ms-3"
                                    onclick="clearImage('ImageFileInput','previewEdit')">
                                <i class="fas fa-xmark"></i> Remove
                            </button>
                        </div>

                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 pt-2 flex-wrap">
                        <button type="submit" class="btn-medibook-primary">
                            <i class="fas fa-floppy-disk"></i> Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.FacilityId"
                           class="btn-medibook-outline">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // ── Required fields (Description excluded since it's optional in Edit) ──
        const requiredFields = [
            { id: 'field-Name',     label: 'Facility Name' },
            { id: 'field-Location', label: 'Location' },
            { id: 'field-Capacity', label: 'Capacity' }
        ];

        document.getElementById('facilityEditForm')
            .addEventListener('submit', function (e) {
                const missing = requiredFields.filter(f => {
                    const el = document.getElementById(f.id);
                    return !el || el.value.trim() === '';
                });

                if (missing.length > 0) {
                    e.preventDefault();

                    requiredFields.forEach(f => {
                        const el = document.getElementById(f.id);
                        if (el) el.classList.remove('is-invalid');
                    });
                    missing.forEach(f => {
                        const el = document.getElementById(f.id);
                        if (el) el.classList.add('is-invalid');
                    });

                    const list = missing.map(f =>
                        `<span style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                            <i class="fas fa-circle fa-2xs" style="color:#dc2626;"></i>${f.label}
                         </span>`
                    ).join('');

                    document.getElementById('toastMessage').innerHTML =
                        `Please fill in the following required field${missing.length > 1 ? 's' : ''}:
                         <div style="margin-top:6px;">${list}</div>`;

                    const toast = document.getElementById('validationToast');
                    toast.style.display = 'block';

                    clearTimeout(window._toastTimer);
                    window._toastTimer = setTimeout(() => {
                        toast.style.display = 'none';
                    }, 6000);

                    const firstEl = document.getElementById(missing[0].id);
                    if (firstEl) firstEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });

        requiredFields.forEach(f => {
            const el = document.getElementById(f.id);
            if (el) el.addEventListener('input', () => el.classList.remove('is-invalid'));
        });

        // ── Image helpers ──
        function previewImage(input, previewId) {
            const container = document.getElementById(previewId);
            const img = document.getElementById(previewId + 'Img');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearImage(inputId, previewId) {
            document.getElementById(inputId).value = '';
            document.getElementById(previewId).classList.add('d-none');
        }

        function handleDrop(event, inputId, previewId, dropZoneId) {
            event.preventDefault();
            document.getElementById(dropZoneId).style.borderColor = '#BDE8F5';
            const files = event.dataTransfer.files;
            if (files.length > 0) {
                const input = document.getElementById(inputId);
                input.files = files;
                previewImage(input, previewId);
            }
        }
    </script>
}