@model MediBook.Models.Facility

@{
    ViewData["Title"] = "Delete Facility";
}

<h2>Delete Facility</h2>
<p>Are you sure you want to delete this facility?</p>

<div>
    <dl>
        <dt>@Html.DisplayNameFor(m => m.Name)</dt>
        <dd>@Html.DisplayFor(m => m.Name)</dd>

        <dt>@Html.DisplayNameFor(m => m.Location)</dt>
        <dd>@Html.DisplayFor(m => m.Location)</dd>

        <dt>@Html.DisplayNameFor(m => m.Capacity)</dt>
        <dd>@Html.DisplayFor(m => m.Capacity)</dd>
        
        <dt>@Html.DisplayNameFor(m => m.ImageUrl)</dt>
        <dd>
            <img src="@Model.ImageUrl" alt="Facility Image" width="80" />
        </dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="FacilityId" />
    <input type="submit" value="Confirm Delete" />
    <a asp-action="Index">Cancel</a>
</form>