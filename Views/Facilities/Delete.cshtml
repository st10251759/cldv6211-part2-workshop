@model MediBook.Models.Facility

@{
    ViewData["Title"] = "Delete Facility";
}

<!-- Page Header -->
<div class="page-header"
     style="background:linear-gradient(135deg,#7f1d1d,#dc2626,#ef4444);">
    <div class="container">
        <div class="page-header-icon" style="background:rgba(255,255,255,0.15);">
            <i class="fas fa-triangle-exclamation"></i>
        </div>
        <h1>Delete Facility</h1>
        <p>This action is permanent and cannot be undone</p>
    </div>
</div>

<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Facilities</a>
                    </li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </nav>

            <div class="delete-card">

                <!-- Card Header -->
                <div class="delete-card-header">
                    <i class="fas fa-trash fa-lg"></i>
                    <div>
                        <h4 style="margin:0;">Confirm Deletion</h4>
                        <span style="color:rgba(255,255,255,0.75); font-size:0.85rem;">
                            You are about to permanently delete this facility
                        </span>
                    </div>
                </div>

                <div class="p-4">

                    <!-- Warning Banner -->
                    <div class="delete-warning">
                        <i class="fas fa-triangle-exclamation fa-lg"></i>
                        <span>
                            <strong>Warning:</strong> Deleting this facility will permanently remove
                            it from the system. This action <strong>cannot be undone</strong>.
                            Ensure no active reservations are linked to this facility before proceeding.
                        </span>
                    </div>

                    <!-- Facility Preview Card -->
                    <div class="row g-3 align-items-center mb-4 p-3"
                         style="background:#f8faff; border-radius:12px; border:1px solid #e2e8f0;">
                        <div class="col-auto">
                            <img src="@(Model.ImageUrl ?? "/images/placeholder-facility.jpg")"
                                 alt="@Model.Name"
                                 style="width:80px; height:70px; object-fit:cover;
                                        border-radius:10px; border:2px solid #BDE8F5;"
                                 onerror="this.src='/images/placeholder-facility.jpg'" />
                        </div>
                        <div class="col">
                            <div style="font-weight:700; font-size:1.05rem; color:#0F2854;">
                                @Model.Name
                            </div>
                            <div style="font-size:0.85rem; color:#64748b; margin-top:4px;">
                                <i class="fas fa-location-dot me-1" style="color:#4988C4;"></i>
                                @Model.Location
                            </div>
                            <div style="font-size:0.82rem; color:#94a3b8; margin-top:4px;">
                                <i class="fas fa-users me-1"></i> Capacity: @Model.Capacity people
                            </div>
                        </div>
                        <div class="col-auto">
                            <span style="background:#fee2e2; color:#dc2626; padding:4px 12px;
                                         border-radius:20px; font-size:0.78rem; font-weight:700;">
                                <i class="fas fa-trash me-1"></i> To Be Deleted
                            </span>
                        </div>
                    </div>

                    <!-- Confirm Delete Form -->
                    <form asp-action="Delete" class="d-flex gap-3 flex-wrap">
                        <input type="hidden" asp-for="FacilityId" />
                        <button type="submit"
                                class="btn-action btn-action-delete"
                                style="padding:11px 26px; font-size:0.92rem; border-radius:50px;">
                            <i class="fas fa-trash"></i> Yes, Delete Permanently
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.FacilityId"
                           class="btn-medibook-outline">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
</div>