@model MediBook.Models.Facility

@{
    ViewData["Title"] = "Facility Details";
}

<h2>Facility Details</h2>

<div>
    <img src="@Model.ImageUrl" alt="Facility Image" width="200" />
    <hr />
    <dl>
        <dt>@Html.DisplayNameFor(m => m.Name)</dt>
        <dd>@Html.DisplayFor(m => m.Name)</dd>

        <dt>@Html.DisplayNameFor(m => m.Location)</dt>
        <dd>@Html.DisplayFor(m => m.Location)</dd>

        <dt>@Html.DisplayNameFor(m => m.Description)</dt>
        <dd>@Html.DisplayFor(m => m.Description)</dd>

        <dt>@Html.DisplayNameFor(m => m.Capacity)</dt>
        <dd>@Html.DisplayFor(m => m.Capacity)</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.FacilityId">Edit</a> |
