@model IEnumerable<MediBook.Models.Facility>

@{
    ViewData["Title"] = "Facilities";
}

<h2>Facilities</h2>
<p>
    <a asp-action="Create">Add New Facility</a>
</p>

<table>
    <thead>
        <tr>
            <th>Image</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>@Html.DisplayNameFor(model => model.Capacity)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImageUrl" alt="Facility Image" width="80" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                <td>@Html.DisplayFor(modelItem => item.Capacity)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.FacilityId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.FacilityId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.FacilityId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>