@model MediBook.Models.Reservation

@{
    ViewData["Title"] = "Edit Reservation";
}

<h2>Edit Reservation</h2>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="ReservationId" />

    <div>
        <label asp-for="FacilityId"></label>
        <select asp-for="FacilityId" asp-items="ViewBag.FacilityId">
            <option value="">-- Select Facility --</option>
        </select>
        <span asp-validation-for="FacilityId"></span>
    </div>

    <div>
        <label asp-for="SessionId"></label>
        <select asp-for="SessionId" asp-items="ViewBag.SessionId">
            <option value="">-- Select Medical Session --</option>
        </select>
        <span asp-validation-for="SessionId"></span>
    </div>

    <div>
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="datetime-local" />
        <span asp-validation-for="StartDate"></span>
    </div>

    <div>
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="datetime-local" />
        <span asp-validation-for="EndDate"></span>
    </div>

    <div>
        <input type="submit" value="Save Changes" />
        <a asp-action="Index">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}