@model MediBook.Models.Reservation

@{
    ViewData["Title"] = "Add Reservation";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="page-header-icon">
            <i class="fas fa-calendar-plus"></i>
        </div>
        <h1>New Reservation</h1>
        <p>Link a clinical facility to a medical session</p>
    </div>
</div>

<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Reservations</a>
                    </li>
                    <li class="breadcrumb-item active">New Reservation</li>
                </ol>
            </nav>

            <div class="medibook-form-card">

                <!-- Card Header -->
                <div class="detail-card-header"
                     style="border-radius:12px 12px 0 0;
                            margin:-2.5rem -2.5rem 2rem -2.5rem;
                            padding:1.5rem 2rem;">
                    <i class="fas fa-calendar-check"></i>
                    <h4>Reservation Details</h4>
                </div>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger d-flex align-items-center gap-2 mb-4"
                         style="border-radius:10px; font-size:0.88rem;">
                        <i class="fas fa-circle-exclamation"></i>
                        <div></div>
                    </div>

                    <!-- Info Banner -->
                    <div class="mb-4 p-3 d-flex align-items-start gap-3"
                         style="background:#f0f7ff; border-radius:10px;
                                border-left:4px solid #4988C4;">
                        <i class="fas fa-circle-info mt-1" style="color:#4988C4;"></i>
                        <span style="font-size:0.88rem; color:#334155;">
                            Select a <strong>facility</strong> and a <strong>medical session</strong>,
                            then specify the reservation time window. The system will validate that
                            no conflicts exist for the selected facility.
                        </span>
                    </div>

                    <!-- Facility & Session Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FacilityId" class="form-label">
                                <i class="fas fa-hospital"></i> Facility
                            </label>
                            <select asp-for="FacilityId"
                                    asp-items="ViewBag.FacilityId"
                                    class="form-select">
                                <option value="">— Select Facility —</option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SessionId" class="form-label">
                                <i class="fas fa-stethoscope"></i> Medical Session
                            </label>
                            <select asp-for="SessionId"
                                    asp-items="ViewBag.SessionId"
                                    class="form-select">
                                <option value="">— Select Session —</option>
                            </select>
                            <span asp-validation-for="SessionId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="mb-4" style="border-top:1px dashed #e2e8f0; padding-top:1.5rem;">
                        <p class="form-label mb-3" style="color:#4988C4; font-weight:700;
                                                           font-size:0.82rem; letter-spacing:1px;
                                                           text-transform:uppercase;">
                            <i class="fas fa-clock me-1"></i> Reservation Time Window
                        </p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label">
                                    <i class="fas fa-calendar-day"></i> Start Date & Time
                                </label>
                                <input asp-for="StartDate"
                                       class="form-control"
                                       type="datetime-local" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label">
                                    <i class="fas fa-calendar-check"></i> End Date & Time
                                </label>
                                <input asp-for="EndDate"
                                       class="form-control"
                                       type="datetime-local" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 pt-2 flex-wrap">
                        <button type="submit" class="btn-medibook-primary">
                            <i class="fas fa-floppy-disk"></i> Save Reservation
                        </button>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}