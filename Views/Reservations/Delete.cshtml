@model MediBook.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
    var duration = Model.EndDate - Model.StartDate;
    var durationText = duration.TotalDays >= 1
        ? $"{(int)duration.TotalDays}d {duration.Hours}h"
        : $"{duration.Hours}h {duration.Minutes}m";
}

<!-- Page Header -->
<div class="page-header"
     style="background:linear-gradient(135deg,#7f1d1d,#dc2626,#ef4444);">
    <div class="container">
        <div class="page-header-icon" style="background:rgba(255,255,255,0.15);">
            <i class="fas fa-triangle-exclamation"></i>
        </div>
        <h1>Delete Reservation</h1>
        <p>This action is permanent and cannot be undone</p>
    </div>
</div>

<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Reservations</a>
                    </li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </nav>

            <div class="delete-card">

                <!-- Card Header -->
                <div class="delete-card-header">
                    <i class="fas fa-trash fa-lg"></i>
                    <div>
                        <h4 style="margin:0;">Confirm Deletion</h4>
                        <span style="color:rgba(255,255,255,0.75); font-size:0.85rem;">
                            You are about to permanently delete reservation #@Model.ReservationId
                        </span>
                    </div>
                </div>

                <div class="p-4">

                    <!-- Warning Banner -->
                    <div class="delete-warning">
                        <i class="fas fa-triangle-exclamation fa-lg"></i>
                        <span>
                            <strong>Warning:</strong> Deleting this reservation will permanently
                            remove the booking record from the system.
                            This action <strong>cannot be undone</strong>.
                        </span>
                    </div>

                    <!-- Reservation Preview Card -->
                    <div class="mb-4 p-3"
                         style="background:#f8faff; border-radius:12px; border:1px solid #e2e8f0;">

                        <!-- ID Badge -->
                        <div class="mb-3">
                            <span style="background:linear-gradient(135deg,#0F2854,#1C4D8D);
                                         color:#BDE8F5; padding:5px 14px; border-radius:20px;
                                         font-size:0.82rem; font-weight:700;">
                                <i class="fas fa-hashtag me-1"></i>
                                Reservation #@Model.ReservationId
                            </span>
                        </div>

                        <div class="row g-3">

                            <!-- Facility -->
                            <div class="col-md-6">
                                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1px;
                                            text-transform:uppercase; color:#4988C4; margin-bottom:4px;">
                                    <i class="fas fa-hospital me-1"></i> Facility
                                </div>
                                <div style="font-weight:600; color:#0F2854; font-size:0.92rem;">
                                    @(Model.Facility?.Name ?? "N/A")
                                </div>
                            </div>

                            <!-- Session -->
                            <div class="col-md-6">
                                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1px;
                                            text-transform:uppercase; color:#4988C4; margin-bottom:4px;">
                                    <i class="fas fa-stethoscope me-1"></i> Medical Session
                                </div>
                                <div style="font-weight:600; color:#0F2854; font-size:0.92rem;">
                                    @(Model.MedicalSession?.Name.Length > 40
                                                                        ? Model.MedicalSession.Name.Substring(0, 40) + "..."
                                                                        : Model.MedicalSession?.Name ?? "N/A")
                                </div>
                            </div>

                            <!-- Start Date -->
                            <div class="col-md-6">
                                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1px;
                                            text-transform:uppercase; color:#4988C4; margin-bottom:4px;">
                                    <i class="fas fa-calendar-day me-1"></i> Start
                                </div>
                                <div style="font-size:0.88rem; color:#334155;">
                                    @Model.StartDate.ToString("dd MMM yyyy — HH:mm")
                                </div>
                            </div>

                            <!-- End Date -->
                            <div class="col-md-6">
                                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1px;
                                            text-transform:uppercase; color:#4988C4; margin-bottom:4px;">
                                    <i class="fas fa-calendar-check me-1"></i> End
                                </div>
                                <div style="font-size:0.88rem; color:#334155;">
                                    @Model.EndDate.ToString("dd MMM yyyy — HH:mm")
                                </div>
                            </div>

                            <!-- Duration -->
                            <div class="col-12">
                                <div style="background:linear-gradient(135deg,#0F2854,#1C4D8D);
                                            color:#fff; border-radius:8px; padding:8px 14px;
                                            display:inline-flex; align-items:center; gap:8px;
                                            font-size:0.85rem;">
                                    <i class="fas fa-hourglass-half" style="color:#BDE8F5;"></i>
                                    <span>Duration: <strong>@durationText</strong></span>
                                </div>

                                <span style="background:#fee2e2; color:#dc2626; padding:6px 14px;
                                             border-radius:20px; font-size:0.78rem; font-weight:700;
                                             margin-left:10px;">
                                    <i class="fas fa-trash me-1"></i> To Be Deleted
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm Delete Form -->
                    <form asp-action="Delete" class="d-flex gap-3 flex-wrap">
                        <input type="hidden" asp-for="ReservationId" />
                        <button type="submit"
                                class="btn-action btn-action-delete"
                                style="padding:11px 26px; font-size:0.92rem; border-radius:50px;">
                            <i class="fas fa-trash"></i> Yes, Delete Permanently
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ReservationId"
                           class="btn-medibook-outline">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>