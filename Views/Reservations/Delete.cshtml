@model MediBook.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<h2>Delete Reservation</h2>
<p>Are you sure you want to delete this reservation?</p>

<dl>
    <dt>Reservation ID</dt>
    <dd>@Html.DisplayFor(m => m.ReservationId)</dd>

    <dt>Facility</dt>
    <dd>@Model.Facility?.Name</dd>

    <dt>Medical Session</dt>
    <dd>@Model.MedicalSession?.Name</dd>

    <dt>@Html.DisplayNameFor(m => m.StartDate)</dt>
    <dd>@Html.DisplayFor(m => m.StartDate)</dd>

    <dt>@Html.DisplayNameFor(m => m.EndDate)</dt>
    <dd>@Html.DisplayFor(m => m.EndDate)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="ReservationId" />
    <input type="submit" value="Confirm Delete" />
    <a asp-action="Index">Cancel</a>
</form>