@model IEnumerable<MediBook.Models.MedicalSession>

@{
    ViewData["Title"] = "Medical Sessions";
}

<h2>Medical Sessions</h2>
<p>
    <a asp-action="Create">Add New Session</a>
</p>

<table>
    <thead>
        <tr>
            <th>Image</th>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.StartDate)</th>
            <th>@Html.DisplayNameFor(m => m.EndDate)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImageUrl" alt="Session Image" width="80" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SessionId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.SessionId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.SessionId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>