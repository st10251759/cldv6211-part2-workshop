@model IEnumerable<MediBook.Models.MedicalSession>

@{
    ViewData["Title"] = "Medical Sessions";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="page-header-icon">
            <i class="fas fa-stethoscope"></i>
        </div>
        <h1>Medical Sessions</h1>
        <p>Manage and view all registered medical sessions</p>
    </div>
</div>

<!-- Main Content -->
<div class="container section-padding">

    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="text-secondary" style="font-size:0.9rem;">
                <i class="fas fa-list me-1" style="color:#4988C4;"></i>
                @Model.Count() session(s) found
            </span>
        </div>
        <a asp-action="Create" class="btn-action-create">
            <i class="fas fa-plus"></i> Add New Session
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table medibook-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-image me-1"></i> Image</th>
                        <th><i class="fas fa-tag me-1"></i> @Html.DisplayNameFor(m => m.Name)</th>
                        <th><i class="fas fa-layer-group me-1"></i> Category</th>
                        <th><i class="fas fa-align-left me-1"></i> Description</th>
                        <th><i class="fas fa-calendar-day me-1"></i> @Html.DisplayNameFor(m => m.StartDate)</th>
                        <th><i class="fas fa-calendar-check me-1"></i> @Html.DisplayNameFor(m => m.EndDate)</th>
                        <th style="text-align:center;"><i class="fas fa-sliders me-1"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(item.ImageUrl ?? "/images/placeholder-session.jpg")"
                                     alt="@item.Name"
                                     class="table-img"
                                     onerror="this.src='/images/placeholder-session.jpg'" />
                            </td>
                            <td>
                                <span style="font-weight:600; color:#0F2854;">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </span>
                            </td>
                            <td>
                                @if (item.Category.HasValue)
                                {
                                    <span class="badge-capacity">@item.Category.Value</span>
                                }
                                else
                                {
                                    <span style="color:#94a3b8; font-size:0.88rem;">Not set</span>
                                }
                        </td>
                        <td>
                            <span style="color:#64748b; font-size:0.88rem;">
                                @(string.IsNullOrEmpty(item.Description) ? "—" :
                                                            (item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description))
                        </span>
                    </td>
                    <td>
                        <span class="badge-capacity">
                            @item.StartDate.ToString("dd MMM yyyy")
                        </span>
                        <div style="font-size:0.78rem; color:#94a3b8; margin-top:2px;">
                            @item.StartDate.ToString("HH:mm")
                        </div>
                    </td>
                    <td>
                        <span class="badge-capacity">
                            @item.EndDate.ToString("dd MMM yyyy")
                        </span>
                        <div style="font-size:0.78rem; color:#94a3b8; margin-top:2px;">
                            @item.EndDate.ToString("HH:mm")
                        </div>
                    </td>
                    <td>
                        <div class="d-flex gap-2 justify-content-center flex-nowrap">
                            <a asp-action="Details" asp-route-id="@item.SessionId"
                               class="btn-action btn-action-details">
                                <i class="fas fa-eye"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.SessionId"
                               class="btn-action btn-action-edit">
                                <i class="fas fa-pen"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.SessionId"
                               class="btn-action btn-action-delete">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
                                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-stethoscope"></i>
            <h5>No Medical Sessions Found</h5>
            <p>No sessions have been added yet. Get started by adding the first session.</p>
            <a asp-action="Create" class="btn-action-create mt-2">
                <i class="fas fa-plus"></i> Add First Session
            </a>
        </div>
    }
</div>