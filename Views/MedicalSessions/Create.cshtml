@model MediBook.Models.MedicalSession

@{
    ViewData["Title"] = "Add Medical Session";
    bool hasServerErrors = !ViewData.ModelState.IsValid &&
        ViewData.ModelState.Any(k => k.Key != "ImageFile" &&
            k.Value!.Errors.Count > 0);
}

<!-- ── Toast Notification ── -->
<div id="validationToast"
     style="position:fixed; top:24px; right:24px; z-index:9999;
            min-width:320px; max-width:420px; display:none;">
    <div style="background:#fff; border-radius:14px;
                box-shadow:0 8px 32px rgba(15,40,84,0.18);
                border-left:5px solid #dc2626; padding:1rem 1.25rem;
                display:flex; align-items:flex-start; gap:12px;
                animation: slideDown 0.4s ease;">
        <div style="width:36px; height:36px; background:#fee2e2; border-radius:50%;
                    display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <i class="fas fa-circle-exclamation" style="color:#dc2626;"></i>
        </div>
        <div style="flex:1;">
            <div style="font-weight:700; color:#991b1b;
                        font-size:0.92rem; margin-bottom:3px;">
                Required Fields Missing
            </div>
            <div id="toastMessage"
                 style="font-size:0.84rem; color:#7f1d1d; line-height:1.5;">
            </div>
        </div>
        <button onclick="document.getElementById('validationToast').style.display='none'"
                style="background:none; border:none; cursor:pointer;
                       color:#94a3b8; font-size:1rem; padding:0; line-height:1;
                       flex-shrink:0; margin-top:2px;">
            <i class="fas fa-xmark"></i>
        </button>
    </div>
</div>

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="page-header-icon">
            <i class="fas fa-plus-circle"></i>
        </div>
        <h1>Add Medical Session</h1>
        <p>Register a new medical session to the system</p>
    </div>
</div>

<!-- Form Content -->
<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Medical Sessions</a>
                    </li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </nav>

            <!-- Server-side error summary -->
            @if (hasServerErrors)
            {
                <div class="d-flex align-items-start gap-3 mb-4 p-3"
                     style="background:#fef2f2; border-radius:12px;
                                border-left:4px solid #dc2626;">
                    <i class="fas fa-circle-exclamation fa-lg mt-1"
                       style="color:#dc2626; flex-shrink:0;"></i>
                    <div asp-validation-summary="ModelOnly"
                         style="font-size:0.88rem; color:#991b1b;"></div>
                </div>
            }

            <div class="medibook-form-card">

                <!-- Card Header -->
                <div class="detail-card-header"
                     style="border-radius:12px 12px 0 0;
                            margin:-2.5rem -2.5rem 2rem -2.5rem;
                            padding:1.5rem 2rem;">
                    <i class="fas fa-stethoscope"></i>
                    <h4>Session Information</h4>
                </div>

                <form asp-action="Create" enctype="multipart/form-data"
                      id="sessionCreateForm" novalidate>

                    <!-- Session Name -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag"></i> Session Name
                        </label>
                        <input asp-for="Name"
                               id="field-Name"
                               class="form-control"
                               placeholder="e.g. Hip Replacement Surgery - Batch A" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-4">
                        <label asp-for="Category" class="form-label">
                            <i class="fas fa-layer-group"></i> Session Category
                        </label>
                        <select asp-for="Category"
                                asp-items="Html.GetEnumSelectList<MediBook.Models.SessionCategory>()"
                                id="field-Category"
                                class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="fas fa-align-left"></i> Description
                        </label>
                        <textarea asp-for="Description"
                                  id="field-Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Provide a brief description of the medical session..."></textarea>
                        <div class="form-text">Maximum 300 characters.</div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Date Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">
                                <i class="fas fa-calendar-day"></i> Start Date &amp; Time
                            </label>
                            <input asp-for="StartDate"
                                   id="field-StartDate"
                                   class="form-control"
                                   type="datetime-local" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">
                                <i class="fas fa-calendar-check"></i> End Date &amp; Time
                            </label>
                            <input asp-for="EndDate"
                                   id="field-EndDate"
                                   class="form-control"
                                   type="datetime-local" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Image Upload -->
                    <div class="mb-4">
                        <label asp-for="ImageFile" class="form-label">
                            <i class="fas fa-upload"></i> Upload Session Image
                            <span style="font-weight:400; color:#94a3b8;
                                         font-size:0.8rem;">(optional)</span>
                        </label>

                        <div style="border:2px dashed #BDE8F5; border-radius:12px;
                                    padding:1.5rem; text-align:center; background:#f8faff;
                                    transition: border-color 0.3s ease;"
                             id="dropZoneCreate"
                             ondragover="event.preventDefault(); this.style.borderColor='#4988C4';"
                             ondragleave="this.style.borderColor='#BDE8F5';"
                             ondrop="handleDrop(event,'ImageFile','previewCreate','dropZoneCreate')">
                            <i class="fas fa-cloud-arrow-up fa-2x mb-2"
                               style="color:#4988C4;"></i>
                            <p class="mb-1" style="font-size:0.88rem; color:#64748b;">
                                Drag &amp; drop an image here, or
                                <label for="ImageFile"
                                       style="color:#1C4D8D; font-weight:600;
                                              cursor:pointer; text-decoration:underline;">
                                    browse
                                </label>
                            </p>
                            <p class="mb-0" style="font-size:0.78rem; color:#94a3b8;">
                                JPG, PNG, GIF, WEBP - max 5 MB
                            </p>
                            <input asp-for="ImageFile"
                                   type="file"
                                   id="ImageFile"
                                   accept="image/*"
                                   class="d-none"
                                   onchange="previewImage(this,'previewCreate')" />
                        </div>

                        <div id="previewCreate" class="mt-3 d-none">
                            <p class="form-label mb-2">
                                <i class="fas fa-eye" style="color:#4988C4;"></i> Preview
                            </p>
                            <img id="previewCreateImg" src="#" alt="Preview"
                                 style="height:120px; width:auto; border-radius:10px;
                                        border:2px solid #BDE8F5;" />
                            <button type="button"
                                    class="btn-action btn-action-delete ms-3"
                                    onclick="clearImage('ImageFile','previewCreate')">
                                <i class="fas fa-xmark"></i> Remove
                            </button>
                        </div>

                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 pt-2 flex-wrap">
                        <button type="submit" class="btn-medibook-primary">
                            <i class="fas fa-floppy-disk"></i> Save Session
                        </button>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const requiredFields = [
            { id: 'field-Name', label: 'Session Name' },
            { id: 'field-Category', label: 'Session Category' },
            { id: 'field-Description', label: 'Description' },
            { id: 'field-StartDate', label: 'Start Date & Time' },
            { id: 'field-EndDate', label: 'End Date & Time' }
        ];

        document.getElementById('sessionCreateForm')
            .addEventListener('submit', function (e) {
                const missing = requiredFields.filter(f => {
                    const el = document.getElementById(f.id);
                    return !el || el.value.trim() === '' || el.value === '0';
                });

                const startEl = document.getElementById('field-StartDate');
                const endEl = document.getElementById('field-EndDate');
                let dateError = null;

                if (startEl.value && endEl.value &&
                    new Date(endEl.value) <= new Date(startEl.value)) {
                    dateError = 'End Date must be after Start Date';
                    endEl.classList.add('is-invalid');
                }

                if (missing.length > 0 || dateError) {
                    e.preventDefault();

                    requiredFields.forEach(f => {
                        const el = document.getElementById(f.id);
                        if (el) el.classList.remove('is-invalid');
                    });
                    missing.forEach(f => {
                        const el = document.getElementById(f.id);
                        if (el) el.classList.add('is-invalid');
                    });

                    let list = missing.map(f =>
                        `<span style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                            <i class="fas fa-circle fa-2xs" style="color:#dc2626;"></i>${f.label}
                         </span>`
                    ).join('');

                    if (dateError) {
                        list += `<span style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                                    <i class="fas fa-circle fa-2xs" style="color:#dc2626;"></i>${dateError}
                                 </span>`;
                    }

                    const intro = missing.length > 0
                        ? `Please fill in the following required field${missing.length > 1 ? 's' : ''}:`
                        : 'Please fix the following:';

                    document.getElementById('toastMessage').innerHTML =
                        `${intro}<div style="margin-top:6px;">${list}</div>`;

                    const toast = document.getElementById('validationToast');
                    toast.style.display = 'block';

                    clearTimeout(window._toastTimer);
                    window._toastTimer = setTimeout(() =>
                        toast.style.display = 'none', 6000);

                    const firstInvalid = document.querySelector('.is-invalid');
                    if (firstInvalid)
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });

        requiredFields.forEach(f => {
            const el = document.getElementById(f.id);
            if (el) el.addEventListener('input', () => el.classList.remove('is-invalid'));
            if (el) el.addEventListener('change', () => el.classList.remove('is-invalid'));
        });

        function previewImage(input, previewId) {
            const container = document.getElementById(previewId);
            const img = document.getElementById(previewId + 'Img');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearImage(inputId, previewId) {
            document.getElementById(inputId).value = '';
            document.getElementById(previewId).classList.add('d-none');
        }

        function handleDrop(event, inputId, previewId, dropZoneId) {
            event.preventDefault();
            document.getElementById(dropZoneId).style.borderColor = '#BDE8F5';
            const files = event.dataTransfer.files;
            if (files.length > 0) {
                const input = document.getElementById(inputId);
                input.files = files;
                previewImage(input, previewId);
            }
        }
    </script>
}