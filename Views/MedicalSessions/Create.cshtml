@model MediBook.Models.MedicalSession

@{
    ViewData["Title"] = "Add Medical Session";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <div class="page-header-icon">
            <i class="fas fa-plus-circle"></i>
        </div>
        <h1>Add Medical Session</h1>
        <p>Register a new medical session to the system</p>
    </div>
</div>

<!-- Form Content -->
<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb medibook-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">Medical Sessions</a>
                    </li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </nav>

            <div class="medibook-form-card">

                <!-- Card Header -->
                <div class="detail-card-header" style="border-radius:12px 12px 0 0; margin:-2.5rem -2.5rem 2rem -2.5rem; padding:1.5rem 2rem;">
                    <i class="fas fa-stethoscope"></i>
                    <h4>Session Information</h4>
                </div>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger d-flex align-items-center gap-2 mb-4"
                         style="border-radius:10px; font-size:0.88rem; display:none!important;">
                        <i class="fas fa-circle-exclamation"></i>
                        <div></div>
                    </div>

                    <!-- Session Name -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag"></i> Session Name
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Hip Replacement Surgery — Batch A" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="fas fa-align-left"></i> Description
                            <span style="font-weight:400; color:#94a3b8; font-size:0.8rem;">(optional)</span>
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Provide a brief description of the medical session..."></textarea>
                        <div class="form-text">Maximum 300 characters.</div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Date Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">
                                <i class="fas fa-calendar-day"></i> Start Date & Time
                            </label>
                            <input asp-for="StartDate"
                                   class="form-control"
                                   type="datetime-local" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">
                                <i class="fas fa-calendar-check"></i> End Date & Time
                            </label>
                            <input asp-for="EndDate"
                                   class="form-control"
                                   type="datetime-local" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-4">
                        <label asp-for="ImageUrl" class="form-label">
                            <i class="fas fa-image"></i> Image URL
                            <span style="font-weight:400; color:#94a3b8; font-size:0.8rem;">(optional)</span>
                        </label>
                        <input asp-for="ImageUrl"
                               class="form-control"
                               placeholder="/images/placeholder-session.jpg" />
                        <div class="form-text">Leave blank to use the default placeholder image.</div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 pt-2 flex-wrap">
                        <button type="submit" class="btn-medibook-primary">
                            <i class="fas fa-floppy-disk"></i> Save Session
                        </button>
                        <a asp-action="Index" class="btn-medibook-outline">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}